<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:backgroundTint="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Title -->
        <TextView
            android:id="@+id/noteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sample Note Title"
            android:textColor="#000000"
            android:textSize="25sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="8dp" />

        <!-- Uploader info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Profile image -->
            <ImageView
                android:id="@+id/uploaderProfileImage"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/profile_logo"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_background"
                android:layout_marginEnd="8dp" />

            <!-- Vertical layout for uploader name + date -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/uploaderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Uploader Name"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/noteDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="November 5, 2025"
                    android:textColor="#777"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- Description -->
        <TextView
            android:id="@+id/noteDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Short note description here."
            android:textColor="#333333"
            android:textSize="14sp"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginBottom="10dp" />

        <!-- Note image -->
        <ImageView
            android:id="@+id/noteImage"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:background="#E0E0E0"
            android:src="@drawable/sample_note"
            android:layout_marginBottom="8dp" />

        <!-- Bottom action bar (Save + Comment buttons) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <!-- Save button -->
            <LinearLayout
                android:id="@+id/saveButtonLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="@drawable/rounded_button_bg">

                <ImageView
                    android:id="@+id/saveButton"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/unsaved_logo"
                    app:tint="#7B1E1E"
                    android:contentDescription="Save note" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save"
                    android:textColor="#7B1E1E"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Comment button -->
            <LinearLayout
                android:id="@+id/commentButtonLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="@drawable/rounded_button_bg">

                <ImageView
                    android:id="@+id/commentButton"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/comment_logo"
                    app:tint="#7B1E1E"
                    android:contentDescription="Comment" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comment"
                    android:textColor="#7B1E1E"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
