<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFDDDD"
    tools:context=".NoteDetailsActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/noteDetailsToolbar"
        android:layout_width="412dp"
        android:layout_height="63dp"
        android:layout_marginBottom="731dp"
        android:background="#7B1E1E"
        android:minHeight="?attr/actionBarSize"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.49"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:navigationIcon="@drawable/baseline_arrow_back_24"
        app:navigationIconTint="@color/white"
        app:subtitleTextAppearance="@style/TextAppearance.AppCompat.Medium"
        app:title="Note Details"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:id="@+id/scrollViewNoteDetails"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:nestedScrollingEnabled="true"
        android:scrollbars="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/noteDetailsToolbar"
        app:layout_constraintBottom_toTopOf="@id/commentSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title + Save Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/noteTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Sample Note Title"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/saveButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="19dp"
                    android:contentDescription="Save Note"
                    android:src="@drawable/saved_logo"
                    app:tint="#7B1E1E" />
            </RelativeLayout>

            <!-- Uploaded By Row -->
            <LinearLayout
                android:id="@+id/uploaderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <!-- Profile Picture -->
                <ImageView
                    android:id="@+id/uploaderProfileImage"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/circle_background"
                    android:scaleType="centerCrop"
                    android:src="@drawable/profile_logo" />

                <!-- Uploaded by + Name -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/uploaderName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jane Doe"
                        android:textColor="#000000"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/uploadedByLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Uploaded by"
                        android:textColor="#555555"
                        android:textSize="11sp"
                        android:textStyle="italic" />
                </LinearLayout>
            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/noteDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This is the note description. It explains what this note is about."
                android:textSize="15sp"
                android:textColor="#333333"
                android:layout_marginBottom="16dp" />

            <!-- Uploaded Image -->
            <ImageView
                android:id="@+id/noteImage"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scaleType="centerCrop"
                android:src="@drawable/sample_note"
                android:background="#CCCCCC"
                android:layout_marginBottom="20dp" />

            <!-- Comments Title -->
            <TextView
                android:id="@+id/commentsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comments"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#7B1E1E"
                android:layout_marginBottom="8dp" />

            <!-- RecyclerView for Comments -->

            <!-- Empty Comments Placeholder -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/commentsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:listitem="@layout/item_comment" />

            <TextView
                android:id="@+id/emptyCommentsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No comments yet."
                android:textColor="#777777"
                android:textSize="15sp"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginTop="10dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Fixed Comment Section -->
    <LinearLayout
        android:id="@+id/commentSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="6dp">

        <EditText
            android:id="@+id/commentEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/edittext_background"
            android:hint="Write a comment..."
            android:minHeight="48dp"
            android:padding="10dp"
            android:textColor="#000000"
            android:textSize="14sp" />

        <Button
            android:id="@+id/postCommentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#7B1E1E"
            android:text="Send"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>