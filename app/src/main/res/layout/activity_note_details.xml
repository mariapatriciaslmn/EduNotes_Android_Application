<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFDDDD"
    tools:context=".NoteDetailsActivity">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/noteDetailsToolbar"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:background="#7B1E1E"
        android:minHeight="?attr/actionBarSize"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/baseline_arrow_back_24"
        app:navigationIconTint="@android:color/white"
        app:title="Note Details"
        app:titleTextColor="@android:color/white" />

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/scrollViewNoteDetails"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/noteDetailsToolbar"
        app:layout_constraintBottom_toTopOf="@id/commentSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Note Title -->
            <TextView
                android:id="@+id/noteTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sample Note Title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="8dp"/>

            <!-- Note Date Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <!-- Profile Picture -->
                <ImageView
                    android:id="@+id/uploaderProfileImage"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_marginEnd="8dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/circle_background"
                    android:src="@drawable/profile_logo" />

                <!-- Name + Date -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/uploaderName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jane Doe"
                        android:textSize="18sp"
                        android:textColor="#000000"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/noteDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nov 10, 2025"
                        android:textSize="13sp"
                        android:textColor="#555555"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/noteDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This is the note description..."
                android:textSize="15sp"
                android:textColor="#333333"
                android:layout_marginBottom="16dp"/>

            <!-- Note Image -->
            <ImageView
                android:id="@+id/noteImage"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scaleType="centerCrop"
                android:src="@drawable/sample_note"
                android:background="#CCCCCC"
                android:layout_marginBottom="12dp"/>

            <!-- Save + Comment Buttons Row -->
            <LinearLayout
                android:id="@+id/buttonsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="2"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/saveButton"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:contentDescription="Save Note"
                    android:src="@drawable/unsaved_logo"
                    app:tint="#7B1E1E" />

                <ImageView
                    android:id="@+id/commentButton"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:contentDescription="Go to Comments"
                    android:src="@drawable/comment_logo"
                    app:tint="#7B1E1E" />
            </LinearLayout>

            <!-- Comments Title -->
            <TextView
                android:id="@+id/commentsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comments"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#7B1E1E"
                android:layout_marginBottom="8dp"/>

            <!-- RecyclerView for comments -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/commentsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:listitem="@layout/item_comment"/>

            <TextView
                android:id="@+id/emptyCommentsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No comments yet."
                android:textSize="15sp"
                android:textColor="#777777"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginTop="10dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Fixed Comment Section -->
    <LinearLayout
        android:id="@+id/commentSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/commentEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/edittext_background"
            android:hint="Write a comment..."
            android:minHeight="48dp"
            android:padding="10dp"
            android:textColor="#000000"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/postCommentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#7B1E1E"
            android:text="Send"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
